{
    "compilerOptions": {
      "esModuleInterop": true,
      "allowSyntheticDefaultImports": true,
      "target": "es6",
      "module": "commonjs",
      "outDir": "dist",
      "sourceMap": false,
      "declaration": true,
      "lib": [
        "es2017.object",
        "es2015",
        "es2017",
        "dom"
      ]
    },
    "include": [
      "src/**/*.ts",
      "__tests__/**/*.ts"
    ],
    "types": ["jest", "node"]
}
